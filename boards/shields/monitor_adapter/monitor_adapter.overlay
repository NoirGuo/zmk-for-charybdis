#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &monitor_kscan;
        zephyr,display = &monitor_oled;
    };

    monitor_kscan: kscan {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };
};

/* nice_nano I2C0: SDA = P0.17, SCL = P0.20 (same as Sofle monitor receiver).
 * If your OLED is wired to different pins, adjust the psels below.
 */
&pinctrl {
    monitor_i2c0_default: monitor_i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                    <NRF_PSEL(TWIM_SCL, 0, 20)>;
        };
    };

    monitor_i2c0_sleep: monitor_i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
                    <NRF_PSEL(TWIM_SCL, 0, 20)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twi";
    pinctrl-0 = <&monitor_i2c0_default>;
    pinctrl-1 = <&monitor_i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    monitor_oled: sh1106@3c {
        compatible = "sinowealth,sh1106";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <2>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        prechargep = <0x22>;
    };
};
