#include "charybdis.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
// 注意：这里不要 include <input/processors.dtsi>。
// keymap（EXTRA_DTC_OVERLAY_FILE）已 include 它，二者在同一预处理单元，
// 重复 include（无 include guard）会导致 zip_* 节点重复定义。
// zip_xy_swap_mapper / zip_xy_to_scroll_mapper / zip_scroll_scaler
// 标签由 keymap 顶部的 #include <input/processors.dtsi> 提供。

&default_transform {
    col-offset = <6>;
}; 

&kscan0 {
	col-gpios
		= <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		, <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
		;
};

// trackball bus
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 17)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 8)>,
                <NRF_PSEL(SPIM_MOSI, 0, 17)>,
                <NRF_PSEL(SPIM_MISO, 0, 17)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        motion-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        zephyr,axis-x = <INPUT_REL_X>;
        zephyr,axis-y = <INPUT_REL_Y>;
        // 与原 PMW3610_CPI=400 等价
        res-cpi = <400>;
        // 与原 CONFIG_PMW3610_SMART_ALGORITHM=y 等价
        smart-mode;
        // 传感器 90° 安装 + X 反转（原 ORIENTATION_90 + INVERT_X）：
        // 驱动输出 x'=-raw_x、y'=-raw_y，再经 listener 的 X↔Y swap 得到
        // x=-raw_y、y=-raw_x，与原驱动方向处理完全一致
        invert-x;
        invert-y;
    };
};


//RGB bus
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
        };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 10)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        /* SPI */
        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* WS2812 */
        chain-length = <27>; /* number of LEDs */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};







/ {
    /* 右半（peripheral）：轨迹球原始 input 事件经 split 转发到 dongle（central）。
     * 方向/滚动处理（zip_*）移到 dongle 的 input-listener。
     * 依赖 keymap 顶部 #include <input/processors.dtsi> 提供的 zip_* 标签。
     * 容器 #size-cells = 0，使 reg 只有 address cell（通道号）。 */
    input_splits {
        #address-cells = <1>;
        #size-cells = <0>;
        input_split: input_split {
            compatible = "zmk,input-split";
            reg = <0>;
            device = <&trackball>;
        };
    };
};
