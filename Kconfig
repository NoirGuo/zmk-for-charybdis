config ZMK_KEY_STATS
    bool "Track physical key press statistics"
    default n
    depends on SETTINGS
    help
      Count only ZMK physical key position press events. Encoder sensor events and pointing
      input events are intentionally not counted.

config ZMK_KEY_STATS_SAVE_DEBOUNCE_SECONDS
    int "Delay before saving key statistics"
    default 30
    depends on ZMK_KEY_STATS

config ZMK_KEY_STATS_SAVE_PRESS_INTERVAL
    int "Save key statistics every N key presses"
    default 50
    depends on ZMK_KEY_STATS

config ZMK_DONGLE_MONITOR
    bool "Build the display receiver as a BLE status monitor"
    default n
    depends on BT && BT_OBSERVER && ZMK_DISPLAY
    help
      Listen for Prospector-compatible keyboard status advertisements instead
      of acting as the split keyboard central. The OLED theme code is shared
      with the normal dongle build.

config ZMK_DONGLE_MONITOR_CHANNEL
    int "Prospector channel accepted by the monitor"
    range 0 255
    default 0
    depends on ZMK_DONGLE_MONITOR
    help
      Zero accepts every Prospector channel. A non-zero value accepts that
      channel and keyboards broadcasting on channel zero.
